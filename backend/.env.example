NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://smallbiz:smallbiz_secret@localhost:5432/smallbiz
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long_here
JWT_EXPIRES_IN=7d

# Only used when NODE_ENV=production. Comma-separated list of origins
# that may call the API. Requests from any other origin are rejected.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=
